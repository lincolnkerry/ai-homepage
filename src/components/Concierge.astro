---
// Site-wide AI concierge: instant local search now; LLM answers when the
// Cloudflare Worker endpoint is live (see workers/README.md).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div id="cg-root">
  <button id="cg-fab" aria-label="Ask INFONET">✳ Ask INFONET</button>
  <div id="cg-panel" hidden>
    <div id="cg-head">
      <strong>INFONET Concierge</strong>
      <button id="cg-close" aria-label="Close">×</button>
    </div>
    <div id="cg-body">
      <p class="cg-hint">Ask about our research, papers, courses, or services — Korean or English.</p>
      <div id="cg-out"></div>
    </div>
    <form id="cg-form">
      <input id="cg-q" type="text" placeholder="e.g. compressed sensing 논문 / how to apply" autocomplete="off" />
      <button type="submit">Ask</button>
    </form>
    <p class="cg-foot">For detailed questions, use the&nbsp;<a href="#" class="em" data-u="heungno" data-d="gist.ac.kr">site inquiry email link</a>.</p>
  </div>
</div>

<style>
#cg-fab{position:fixed;right:22px;bottom:22px;z-index:50;background:var(--signal);color:#fff;border:0;border-radius:24px;padding:11px 18px;font-family:var(--mono);font-size:.85rem;cursor:pointer;box-shadow:0 2px 12px rgba(14,110,88,.35)}
#cg-fab:hover{filter:brightness(1.1)}
#cg-panel{position:fixed;right:22px;bottom:76px;z-index:50;width:min(380px,calc(100vw - 44px));max-height:70vh;display:flex;flex-direction:column;background:var(--card);border:1px solid var(--line);border-radius:8px;box-shadow:0 6px 30px rgba(24,36,48,.18)}
#cg-head{display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:1px solid var(--line);font-family:var(--serif)}
#cg-close{background:none;border:0;font-size:1.2rem;cursor:pointer;color:var(--ink-soft)}
#cg-body{padding:12px 16px;overflow-y:auto;flex:1;font-size:.88rem}
.cg-hint{color:var(--ink-soft);font-size:.82rem;margin-bottom:8px}
#cg-form{display:flex;gap:8px;padding:10px 16px;border-top:1px solid var(--line)}
#cg-q{flex:1;padding:8px 10px;border:1px solid var(--line);border-radius:4px;font-family:var(--sans);font-size:.85rem}
#cg-form button{background:var(--signal);color:#fff;border:0;border-radius:4px;padding:8px 14px;font-family:var(--mono);font-size:.8rem;cursor:pointer}
.cg-foot{padding:8px 16px 12px;font-size:.72rem;color:var(--ink-soft);font-family:var(--mono)}
.cg-a{background:var(--accent-bg);border-radius:6px;padding:10px 12px;margin-bottom:10px;white-space:pre-wrap}
.cg-r{border-bottom:1px solid var(--grid);padding:7px 0}
.cg-r a{font-weight:600}
.cg-r p{color:var(--ink-soft);font-size:.8rem;margin-top:2px}
.cg-status{font-family:var(--mono);font-size:.75rem;color:var(--ink-soft);margin:6px 0}
</style>

<script is:inline define:vars={{ base }}>
(function () {
  var ENDPOINT = 'https://worked-father-jar-minnesota.trycloudflare.com/chat';
  var fab = document.getElementById('cg-fab'), panel = document.getElementById('cg-panel');
  var out = document.getElementById('cg-out'), form = document.getElementById('cg-form');
  var input = document.getElementById('cg-q');
  var index = null;

  fab.addEventListener('click', function () {
    panel.hidden = !panel.hidden;
    if (!panel.hidden) { input.focus(); loadIndex(); }
  });
  document.getElementById('cg-close').addEventListener('click', function () { panel.hidden = true; });

  function loadIndex() {
    if (index) return Promise.resolve(index);
    return fetch(base + '/search-index.json').then(function (r) { return r.json(); })
      .then(function (d) { index = d; return d; });
  }

  function tokenize(s) {
    return s.toLowerCase().split(/[^a-z0-9가-힣]+/).filter(function (t) { return t.length > 1; });
  }

  function search(q, k) {
    var qt = tokenize(q);
    var scored = index.map(function (d) {
      var hay = (d.t + ' ' + d.s + ' ' + d.k).toLowerCase();
      var score = 0;
      for (var i = 0; i < qt.length; i++) {
        if (hay.indexOf(qt[i]) >= 0) score += 1;
        if (d.t.toLowerCase().indexOf(qt[i]) >= 0) score += 2;
      }
      return { d: d, score: score };
    }).filter(function (x) { return x.score > 0; });
    scored.sort(function (a, b) { return b.score - a.score; });
    return scored.slice(0, k).map(function (x) { return x.d; });
  }

  function esc(s) {
    var d = document.createElement('div'); d.textContent = s; return d.innerHTML;
  }

  function renderResults(hits, label, limit) {
    var shown = hits.slice(0, limit || 2);
    if (!shown.length) return '<p class="cg-status">No matching source pages found on the site.</p>';
    var h = '<p class="cg-status">' + esc(label || 'Source pages:') + '</p>';
    for (var i = 0; i < shown.length; i++) {
      var d = shown[i];
      var url = d.u.indexOf('http') === 0 ? d.u : base + d.u;
      h += '<div class="cg-r"><a href="' + url + '">' + esc(d.t) + '</a></div>';
    }
    return h;
  }

  form.addEventListener('submit', function (ev) {
    ev.preventDefault();
    var q = input.value.trim();
    if (!q) return;
    out.innerHTML = '<p class="cg-status">Searching…</p>';
    loadIndex().then(function () {
      var hits = search(q, 5);
      out.innerHTML = renderResults(hits, 'Source links:', 2);
      askLLM(q, hits);
    });
  });

  function askLLM(q, hits) {
    var ansBox = document.createElement('div');
    ansBox.className = 'cg-a';
    ansBox.textContent = 'Thinking…';
    out.insertBefore(ansBox, out.firstChild);
    var ctx = hits.map(function (d) { return d.t + ': ' + (d.s || d.k).slice(0, 300); });
    var timer = null;
    var signal = null;
    if (window.AbortSignal && AbortSignal.timeout) {
      signal = AbortSignal.timeout(30000);
    } else if (window.AbortController) {
      var controller = new AbortController();
      signal = controller.signal;
      timer = setTimeout(function () { controller.abort(); }, 30000);
    }
    fetch(ENDPOINT, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ question: q, context: ctx }),
      signal: signal,
    }).then(function (r) {
      if (timer) clearTimeout(timer);
      if (r.status === 429) {
        ansBox.textContent = '요청이 많습니다. 잠시 후 다시 시도해 주세요. Too many requests — please try again shortly.';
        return null;
      }
      if (!r.ok) throw new Error('bad status');
      return r.json();
    }).then(function (d) {
      if (!d) return;
      var labels = {
        PRAX: 'AI answer',
        'PRAX-safety': 'AI answer',
        fallback: 'AI 답변을 받지 못했습니다 — 아래 사이트 검색 결과를 참고하세요'
      };
      ansBox.textContent = (labels[d.agent] || 'AI answer') + ':\n\n' + d.answer;
    }).catch(function () {
      if (timer) clearTimeout(timer);
      ansBox.textContent = 'The AI answer service is not live yet — the links below are matched from the site. For a detailed answer, use the site inquiry link.';
    });
  }
})();
</script>
