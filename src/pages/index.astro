---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import biz from '../data/biz.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('news')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 4);
const fmt = (d) => d.toISOString().slice(0, 10);
---
<Base>
<header class="hero">
  <div class="wrap">
    <div class="eyebrow">INFONET — Information Sensing, Processing, Controlling &amp; Networking Lab</div>
    <h1>Research that you can read, hear, and run.</h1>
    <p class="sub">
      We study information theory, AI systems, and Web3 trust infrastructure at GIST.
      This site is operated by our own AI agents: they report our research as news,
      narrate it as audio, and answer your questions instantly.
    </p>
    <p class="formula">C = max<sub>p(x)</sub> I(X; Y)</p>
    <div class="facts">
      <span>124 journal papers</span>
      <span>42 open repos</span>
      <span>est. 2002 · GIST since 2009</span>
      <span>relaunch 2026-08-20</span>
    </div>
  </div>
</header>

<section>
  <div class="wrap">
    <h2>Latest from the newsroom</h2>
    <p class="sec-note">Articles drafted by our AI journalist from lab discussions, reviewed by humans before publication.</p>
    <div class="post-list">
      {posts.map(p => (
        <div class="post-item">
          <div class="meta">{fmt(p.data.date)} · {p.data.category} · {p.data.author}</div>
          <h3><a href={`${base}/news/${p.id.replace(/\.md$/, '')}`}>{p.data.title}</a></h3>
          <p style="font-size:.9rem;color:var(--ink-soft)">{p.data.summary}</p>
        </div>
      ))}
    </div>
    <p style="margin-top:16px"><a href={`${base}/news`} class="cta">All news →</a></p>
  </div>
</section>

<section>
  <div class="wrap">
    <h2>Try what we build</h2>
    <p class="sec-note">Our research ships as services. Use them, evaluate them, and talk to us about collaboration.</p>
    <div class="cards">
      {biz.map(b => (
        <div class="card">
          <div class="tag">{b.tag}</div>
          <h3>{b.name}</h3>
          <p>{b.summary}</p>
          <div class="cta">{b.url ? <a href={b.url}>Visit →</a> : <span style="color:var(--ink-soft)">Pilot — coming soon</span>}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <h2>For companies</h2>
    <p class="sec-note">
      Evaluate our technology on your own data, request a benchmark, or propose a joint
      project. <a href="#" class="em" data-u="heungno" data-d="gist.ac.kr">Email the professor</a>,
      or ask the AI concierge at the bottom-right of this page.
    </p>
  </div>
</section>
</Base>
