---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="People · INFONET @ GIST">
<header class="hero">
  <div class="wrap">
    <div class="eyebrow">People</div>
    <h1>Heung-No Lee &amp; INFONET members</h1>
    <p class="sub">
      Professor, School of EECS &amp; AI Graduate School, GIST. 130+ IEEE journal papers
      across information theory, signal processing, neural networks, and communications.
      CEO of LiberVance; supervisor of the WorldLand Foundation.
      Contact: <a href="#" class="em" data-u="heungno" data-d="gist.ac.kr">heungno [at] gist.ac.kr</a>
    </p>
  </div>
</header>
<section>
  <div class="wrap">
    <h2>Members &amp; alumni</h2>
    <div class="cards" style="margin-bottom:20px">
      <div class="card"><div class="tag">profile</div><h3><a href={`${base}/archive/professor`}>Professor</a></h3><p>Biography, positions, awards — <a href={`${base}/archive/professor-kor`}>한국어</a>.</p></div>
      <div class="card"><div class="tag">roster</div><h3><a href={`${base}/archive/members`}>Current members</a></h3><p>Ph.D. and M.S. researchers of INFONET.</p></div>
      <div class="card"><div class="tag">alumni</div><h3><a href={`${base}/archive/alumni`}>Alumni</a></h3><p>Graduates since 2002 and where they went.</p></div>
      <div class="card"><div class="tag">honors</div><h3><a href={`${base}/archive/awards`}>Awards</a></h3><p>Lab and member honors.</p></div>
    </div>
    <p class="sec-note">
      <strong>Prospective students:</strong> we accept international applications —
      see the <a href="https://heungno.net/wp-content/uploads/2025/09/INFONETLABAdmissionSchedule-2.pdf">admission schedule (PDF)</a>
      or <a href="#" class="em" data-u="heungno" data-d="gist.ac.kr">email the professor</a>.
    </p>
  </div>
</section>
</Base>
