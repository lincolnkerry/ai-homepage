---
import Base from '../layouts/Base.astro';
import biz from '../data/biz.json';
---
<Base title="Biz · INFONET @ GIST">
<header class="hero">
  <div class="wrap">
    <div class="eyebrow">Biz</div>
    <h1>Research, shipped as services</h1>
    <p class="sub">
      Our results are products. Try them, evaluate their quality on your own data,
      and propose a joint project or contract research.
    </p>
  </div>
</header>
<section>
  <div class="wrap">
    <div class="cards">
      {biz.map(b => (
        <div class="card">
          <div class="tag">{b.tag}</div>
          <h3>{b.name}</h3>
          <p>{b.summary}</p>
          <div class="cta">
            {b.links.length
              ? b.links.map((l, i) => <span>{i > 0 && ' · '}<a href={l.url}>{l.label} →</a></span>)
              : <span style="color:var(--ink-soft)">Pilot — public access soon</span>}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
<section>
  <div class="wrap">
    <h2>Work with us</h2>
    <p class="sec-note">
      Quality evaluation on your data, benchmark reports, contract research, and
      collaboration proposals: <a href="mailto:heungno@gist.ac.kr">heungno@gist.ac.kr</a>.
      A structured proposal form with instant AI triage launches with the new site.
    </p>
  </div>
</section>
</Base>
