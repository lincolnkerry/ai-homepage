---
import Base from '../../layouts/Base.astro';
import meta from '../../archive-html/_meta.json';

export async function getStaticPaths() {
  const metaData = (await import('../../archive-html/_meta.json')).default;
  const files = import.meta.glob('../../archive-html/*.html', { query: '?raw', import: 'default' });
  const paths = [];
  for (const slug of Object.keys(metaData)) {
    const loader = files[`../../archive-html/${slug}.html`];
    if (!loader) continue;
    paths.push({ params: { slug }, props: { html: await loader(), title: metaData[slug].title } });
  }
  return paths;
}
const { html, title } = Astro.props;
---
<Base title={`${title} · INFONET @ GIST`}>
<header class="hero">
  <div class="wrap">
    <div class="eyebrow">Archive</div>
    <h1 style="font-size:clamp(1.6rem,4vw,2.4rem)">{title}</h1>
    <p class="sub" style="font-family:var(--mono);font-size:.78rem">Migrated from the WordPress site — reformatting in progress.</p>
  </div>
</header>
<section>
  <div class="wrap prose archive-body" set:html={html} />
</section>
<style is:global>
  .archive-body img{max-width:100%;height:auto;border:1px solid var(--line);border-radius:4px}
  .archive-body table{font-size:.85rem}
  .archive-body figure{margin:0 0 1em}
</style>
</Base>
