---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('news')).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d) => d.toISOString().slice(0, 10);
---
<Base title="News · INFONET @ GIST">
<header class="hero">
  <div class="wrap">
    <div class="eyebrow">Newsroom</div>
    <h1>News</h1>
    <p class="sub">Research stories mined from our Slack discussions and journal clubs by an AI journalist, and approved by human editors.</p>
  </div>
</header>
<section>
  <div class="wrap">
    <div class="post-list">
      {posts.map(p => (
        <div class="post-item">
          <div class="meta">{fmt(p.data.date)} · <span class="badge">{p.data.category}</span> · {p.data.author}</div>
          <h3><a href={`${base}/news/${p.id.replace(/\.md$/, '')}`}>{p.data.title}</a></h3>
          <p style="font-size:.9rem;color:var(--ink-soft)">{p.data.summary}</p>
        </div>
      ))}
    </div>
  </div>
</section>
</Base>
