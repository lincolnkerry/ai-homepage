---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d) => d.toISOString().slice(0, 10);
---
<Base title={`${post.data.title} · INFONET @ GIST`} description={post.data.summary}>
<header class="hero">
  <div class="wrap">
    <div class="eyebrow">{fmt(post.data.date)} · {post.data.category} · {post.data.author}</div>
    <h1 style="font-size:clamp(1.6rem,4vw,2.4rem)">{post.data.title}</h1>
    {post.data.source && <p class="sub" style="font-family:var(--mono);font-size:.8rem">source: {post.data.source}</p>}
  </div>
</header>
<section>
  <div class="wrap prose">
    <Content />
  </div>
</section>
</Base>
