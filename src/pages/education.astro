---
import Base from '../layouts/Base.astro';
import playlists from '../data/playlists.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const courses = [
  { name: 'Information Theory', when: 'Fall 2026', link: 'https://lincolnkerry.github.io/infotheory-2026/', live: true, desc: 'EC5301 — with AI TA and AI-graded homework. The pilot of our AI-native education format.' },
  { name: 'Generative AI and Blockchain', when: 'Spring 2026', link: `${base}/archive/genai-blockchain`, desc: 'Graduate course on generative AI systems and blockchain convergence.' },
  { name: 'Information Theory 2025', when: 'Fall 2025', link: `${base}/archive/information-theory-2025`, desc: 'Previous offering — lecture notes and course materials.' },
  { name: 'Blockchain and Future Society', when: 'STAR-MOOC', link: `${base}/archive/blockchain-future-society`, desc: 'Open online course, offered since 2018.' },
  { name: 'Introduction to Compressed Sensing', when: 'Archive', link: `${base}/archive/compressive-sensing`, desc: 'Graduate course and research materials on compressive sensing.' },
  { name: 'Channel Coding Theory · Wireless Communications · more', when: 'Archive', link: `${base}/archive/courses-wp`, desc: 'Full course archive dating to 2002, including University of Pittsburgh years.' },
];
---
<Base title="Education · INFONET @ GIST">
<header class="hero">
  <div class="wrap">
    <div class="eyebrow">Education</div>
    <h1>Courses &amp; lectures</h1>
    <p class="sub">Courses with AI teaching assistants and automated grading, public lectures on YouTube, and interactive learning modules to come.</p>
  </div>
</header>
<section>
  <div class="wrap">
    <div class="cards">
      {courses.map(c => (
        <div class="card">
          <div class="tag">{c.when}</div>
          <h3>{c.name}</h3>
          <p>{c.desc}</p>
          {c.link && <div class="cta"><a href={c.link}>{c.live ? 'Course site →' : 'Details →'}</a></div>}
        </div>
      ))}
    </div>
    <p class="sec-note" style="margin-top:20px">
      More: <a href={`${base}/archive/courses-wp`}>full course archive (2002–2026)</a> ·
      <a href={`${base}/archive/lectures`}>public lectures &amp; manuscripts (2016–2025)</a> ·
      <a href={`${base}/archive/media`}>media coverage</a>.
    </p>
  </div>
</section>

<section>
  <div class="wrap">
    <h2>Watch</h2>
    <p class="sec-note">196+ lecture and seminar videos on the <a href={playlists.channel}>lab YouTube channel</a>, organized by playlist.</p>
    {playlists.groups.map(g => (
      <div style="margin-bottom:22px">
        <h3 style="margin-bottom:10px">{g.title}</h3>
        <div class="facts" style="margin-top:0">
          {g.items.map(p => (
            <span><a href={p.url}>{p.name}</a> <span style="color:var(--ink-soft)">({p.n})</span></span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
</Base>
