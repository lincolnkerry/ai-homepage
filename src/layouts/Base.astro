---
import '../styles/global.css';
const { title = 'INFONET @ GIST', description = 'Information Sensing, Processing, Controlling, and Networking Laboratory — GIST. Information theory, AI systems, Web3 trust infrastructure.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  { href: `${base}/`, label: 'Home' },
  { href: `${base}/news`, label: 'News' },
  { href: `${base}/research`, label: 'Research' },
  { href: `${base}/publications`, label: 'Publications' },
  { href: `${base}/code`, label: 'Code & Demos' },
  { href: `${base}/education`, label: 'Education' },
  { href: `${base}/biz`, label: 'Biz' },
  { href: `${base}/people`, label: 'People' },
];
const path = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=STIX+Two+Text:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
<nav>
  <div class="wrap">
    <a class="brand" href={`${base}/`}>INFONET · GIST</a>
    {nav.slice(1).map(n => (
      <a class={`nl${path.startsWith(n.href) && n.href !== `${base}/` ? ' active' : ''}`} href={n.href}>{n.label}</a>
    ))}
  </div>
</nav>

<slot />

<footer>
  <div class="wrap cols">
    <div>
      <div class="h">INFONET Lab</div>
      School of EECS &amp; AI Graduate School, GIST<br />
      EECS Building C315/317, Gwangju, Korea<br />
      <a href="mailto:heungno@gist.ac.kr">heungno@gist.ac.kr</a>
    </div>
    <div>
      <div class="h">Services</div>
      <a href="https://worldland.foundation">WorldLand</a><br />
      <a href="https://libervance.com">LiberVance</a><br />
      <a href="http://jireumgil.xyz">지름길 Shortcut</a>
    </div>
    <div>
      <div class="h">Elsewhere</div>
      <a href="https://github.com/cryptoecc">GitHub</a><br />
      <a href="https://www.youtube.com/@heung-noleelabgist2902/videos">YouTube</a><br />
      <a href="https://x.com/fighterkerry">X / Twitter</a>
    </div>
  </div>
</footer>
</body>
</html>
